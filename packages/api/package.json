{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "type": "module",
  "scripts": {
    "start": "node --watch --experimental-strip-types src/main.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:analyzer": "node --experimental-strip-types --test src/services/devices/providers/esphome/test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test src/services/analytics/test/*.test.ts",
    "test:feeding": "node --experimental-strip-types --test src/services/devices/providers/surepet/test/*.test.ts src/services/food/test/*.test.ts",
    "migrate": "node --experimental-strip-types src/database/migrate.ts",
    "migrate:down": "node --experimental-strip-types src/database/migrate.ts --down",
    "reset-db": "rm -f data/database.sqlite && npm run migrate",
    "backup-db": "node --experimental-strip-types src/scripts/backup-database.ts",
    "restore-db": "node --experimental-strip-types src/scripts/restore-database.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --force --noEmit"
  },
  "author": "Cristian Chelu",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "typebox": "^1.0.81",
    "better-sqlite3": "^12.6.2",
    "bonjour-service": "^1.3.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.4",
    "esphome-client": "^1.3.1",
    "execa": "^9.6.1",
    "fastify": "^5.7.4",
    "kysely": "^0.28.11",
    "kysely-plugin-serialize": "^0.8.2",
    "node-ssh": "^13.2.1",
    "shared": "*",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
