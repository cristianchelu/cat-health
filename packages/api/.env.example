# Optional: SQLite DB file (default: <repo>/data/database.sqlite)
SQLITE_PATH=
# Optional: permanent media root (default: <repo>/data/media)
MEDIA_PATH=
# Optional: temp uploads (default: <repo>/data/temp)
MEDIA_TEMP_PATH=

# Comma-separated browser origins allowed to call this API (scheme + host + port, no path).
# Include every place the UI runs in a browser, e.g. your public app URL and Home Assistant.
# Example (Home Assistant default URL): http://homeassistant.local:8123
# Example (multiple): https://your-app.example,http://homeassistant.local:8123
CORS_ALLOWED_ORIGINS=
