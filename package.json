{
  "name": "cat-health",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "test": "npm run test:analyzer -w api && npm run test:feeding -w api && npm run test:coverage -w api",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -c blue,magenta -n api,ui \"npm run start -w api\" \"npm run start -w ui\"",
    "dev:api": "npm run start -w api",
    "dev:ui": "npm run start -w ui",
    "dev:shared": "npm run dev -w shared",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "migrate": "npm run migrate -w api",
    "migrate:down": "npm run migrate:down -w api",
    "reset-db": "npm run reset-db -w api",
    "backup-db": "npm run backup-db -w api",
    "restore-db": "npm run restore-db -w api"
  },
  "author": "Cristian Chelu",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristianchelu/cat-health.git"
  },
  "workspaces": [
    "packages/api",
    "packages/ui",
    "packages/shared"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "prettier": "3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
