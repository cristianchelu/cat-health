{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "ui-only",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "ui", "--", "--port", "5199"],
      "port": 5199
    },
    {
      "name": "dev-polling",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "CHOKIDAR_USEPOLLING=1 npm run dev"],
      "port": 5173
    }
  ]
}
