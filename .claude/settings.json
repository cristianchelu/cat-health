{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && \"${CLAUDE_PROJECT_DIR:-.}/node_modules/.bin/prettier\" --ignore-unknown --write \"$f\"; } >/dev/null 2>&1 || true",
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
