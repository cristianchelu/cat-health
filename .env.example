# Override SQLite database path
SQLITE_PATH=
# Override video recording storage path
RECORDING_PATH=
# InfluxDB Configuration
# Get your token from InfluxDB admin interface
INFLUX_TOKEN=
# InfluxDB organization ID
INFLUX_ORG=
# InfluxDB server URL
INFLUX_URL=
# InfluxDB bucket name
INFLUX_BUCKET=

# Migration Configuration
# Date range for migration (ISO format)
MIGRATION_START_DATE=
MIGRATION_END_DATE=
# Number of days to process per batch
MIGRATION_BATCH_DAYS=10

# Camera Configuration  
# IP address of your camera for video recording
CAMERA_IP=
# Camera timezone offset in hours (relative to UTC)
CAMERA_TIMEZONE_OFFSET_HOURS=3

# Algorithm Thresholds
# Weight decrease threshold (in grams) to detect maintenance events
MAINTENANCE_THRESHOLD=-20
# Weight threshold (in grams) below which elimination is considered "none"
NO_ELIMINATION_THRESHOLD=10

# Pet Configuration
# Cat weights in grams (comma-separated: petId:weight)
# Format: "1:6600,2:4300"
CAT_WEIGHTS=
# Pet sensor mappings (comma-separated: sensorName:petId)  
# Format: "Litterbox Jazz Weight:1,Litterbox Luna Weight:2"
PET_SENSOR_MAPPINGS=

# CORS Configuration
# Frontend URL for CORS (use '*' for development, specific URL for production)
FRONTEND_URL=http://localhost:5173
