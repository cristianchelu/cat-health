# Prettier reads .gitignore, but not .git/info/exclude — where the vendored
# design-system bundle and the agent scratch directories are kept. Without these
# lines `npm run format` rewrites ~870 files nobody here owns, which is why it
# was never safe to run.
ds-bundle/
.design-sync/
.ds-sync/
.claude/worktrees/

# Machine-written: npm owns the lockfile's formatting, not us.
package-lock.json
*.tsbuildinfo

# Prettier reads only the *root* .gitignore, never the nested ones, so anything
# a nested .gitignore hides has to be repeated here or prettier will happily
# reformat it. These are generated: the ESPHome fixtures may hold household
# telemetry, and the rest is build output.
packages/api/src/services/devices/providers/esphome/test/metrics_*.json
packages/ui/dev-dist/
packages/ui/public/icons/
